# Copy this file to ".env" and fill in the values. Never commit ".env".

# --- Web app ---
PORT=3000
# 127.0.0.1 = only your own computer. Use 0.0.0.0 when you deploy on a server.
HOST=127.0.0.1
# REQUIRED when HOST is not 127.0.0.1 (the app can spend money, so it must be protected).
APP_PASSWORD=change-this-long-password
# Set to "true" when the site runs behind HTTPS (cookie gets the Secure flag).
COOKIE_SECURE=false

# --- Telegram Ads API (from Ads account settings -> API access token) ---
TG_ADS_TOKEN=
# Default sub-account id (optional). Leave empty to use the main/current account.
TG_ADS_ACCOUNT_ID=
# How parameters are sent: "json" (default) or "form" (if the API complains about arrays/objects).
TG_PARAM_ENCODING=json

# --- Telegram bot used for alerts (optional) ---
TG_BOT_TOKEN=
TG_BOT_CHAT_ID=

# --- Google Sheets (optional, only needed for PRIVATE sheets or writing back) ---
# Either paste the whole service-account JSON on one line, or give the path to the file.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Advanced ---
# TG_ADS_BASE=https://promoteapi.telegram.org
# DATA_DIR=./data
